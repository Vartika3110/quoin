# Postgres. Without this the project silently falls back to SQLite,
# which is for local schema work only — never deploy on it.
DATABASE_URL="postgresql://quoin:password@localhost:5432/quoin"

# Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=""

DJANGO_DEBUG="1"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"

# The Next.js storefront origin.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
