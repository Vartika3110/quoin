# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Supplier catalogues: large third-party binaries whose contents are
# extracted into the database, not served from the repo.
/*.pdf
/catalogs/

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and must be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated product imagery: run output, not source. Regenerate with
# `npm run images:generate`, or serve from object storage in production.
/public/generated

# Harvested catalogue images: the raw pool the pairing screen draws from.
# Regenerate with research/extract-brand-catalogue.py --harvest rather than
# carrying thousands of unattached binaries in the repo.
/research/data/catalogues/*/images/

# public/catalogue is deliberately NOT ignored. Those are the photographs
# the storefront actually serves, and a deploy without them shows a swatch
# where half the catalogue should be. They belong in object storage once
# there is somewhere to put them; until then the repo is that somewhere.
