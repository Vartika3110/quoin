# Copy to .env.local and fill in. Never commit .env.local.

# Postgres — the pooled connection string. On Supabase that is the
# Supavisor URL on port 6543, with ?pgbouncer=true.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# The same database, reached directly on 5432. Used by `prisma migrate`
# only, never at request time: Supavisor's transaction mode drops the
# prepared statements a migration needs. Required whenever the schema
# declares `directUrl` — `prisma generate` does not need it, so the
# deployed build is unaffected, but `prisma migrate deploy` is.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Signs session JWTs and peppers OTP hashes. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# --- Phone sign-in (Supabase Auth) ---------------------------------------
# Supabase Auth now mints, stores, checks and expires the login code, and
# issues the session. Phone sign-in is offered only when this key AND the
# SUPABASE_URL further down are both set; otherwise the sign-in panel says
# SMS is unavailable rather than showing a box that cannot work.
#
# There is deliberately no NEXT_PUBLIC_SUPABASE_URL. The browser never
# talks to Supabase in this app - it posts to /api/v1/auth/otp/* and the
# server makes the Supabase calls - so the project URL is read once, from
# SUPABASE_URL below. Two variables holding one value is a variable that
# goes stale.
#
# Project Settings -> API Keys -> anon / public (or the newer
# sb_publishable_... key; either works). NOT service_role.
SUPABASE_ANON_KEY=""

# Shared secret for Supabase's "Send SMS Hook" - the thing that lets
# Supabase generate the code while MSG91 still delivers it, so the
# existing DLT-registered template keeps being the one that sends.
#
# Authentication -> Hooks -> Send SMS hook. Point it at
#   https://<your-domain>/api/v1/auth/supabase/send-sms
# and paste the generated secret here exactly as shown (v1,whsec_...).
#
# Without it that route refuses every request: it is the only endpoint in
# the app that will text an arbitrary number, so unauthenticated it would
# be an open SMS relay billed to the MSG91 account.
SUPABASE_SMS_HOOK_SECRET=""

# --- SMS delivery (MSG91) ------------------------------------------------
# AUTH_KEY and TEMPLATE_ID are both required for SMS to send: MSG91 selects
# the DLT-registered template by id, so a key without one delivers nothing.
#
# These no longer generate or check anything - since Supabase Auth landed,
# MSG91 is only the carrier, called by the Send SMS Hook above. Needed
# whenever that hook is the delivery route; unnecessary if you configure a
# native Supabase SMS provider (Twilio and friends) instead, which costs
# more for Indian traffic and needs its own DLT registration.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# --- Competitor imagery (demo only) --------------------------------------
# Renders the product photography captured in Product.sourceImageUrl.
#
# Those images belong to the sites they were scraped from and to the
# manufacturers, and serving them hotlinks someone else's CDN. Fine behind
# a private demo link; not something to leave on for a public storefront.
# Unset or "0" keeps the generated swatches.
SHOW_SOURCE_IMAGES="0"

# --- OpenAI (optional) ----------------------------------------------------
# One key, two unrelated jobs.
#
#  1. Reading an uploaded parcha. POST /api/v1/parcha/extract sends the
#     photograph or PDF to OpenAI and puts the materials it reads into the
#     textarea on /upload for the customer to check. This one runs at
#     request time, so the key must be set on the deployment, not just on
#     a laptop.
#  2. `npm run images:generate`, which runs on a laptop and never at
#     request time. Everything it writes is flagged as generated and
#     labelled "Illustration - actual product may vary" in the storefront.
#
# SERVER ONLY. Never NEXT_PUBLIC_, never in a response body, never in a
# log line - the browser posts the file to this app and this app talks to
# OpenAI. Treat it exactly like RAZORPAY_KEY_SECRET.
#
# Optional. Unset, the app boots and /upload works exactly as it did
# before this feature existed: typing a list is priced end to end, and an
# attached file is routed to a person instead. Nothing 500s.
OPENAI_API_KEY=""

# Which model reads the file. Optional - leave blank for the default in
# src/lib/parcha-openai.ts (gpt-5-mini: vision-capable, cheap, and it
# reads a whole PDF rather than only its first page).
#
# A variable rather than a constant because model names age faster than
# deploys. If the account has no access to the default, the extract route
# logs the model name alongside the upstream refusal and this is the one
# knob to turn - `gpt-4.1-mini` is the drop-in replacement.
OPENAI_MODEL=""

# --- Google sign-in --------------------------------------------------------
# Both optional, and — like Razorpay below — there is no boot guard on
# them: unset, the app runs normally and the "Continue with Google" button
# simply is not shown. SMS stays the only sign-in method until these are
# set, and setting these does not touch SMS at all — both can be live at
# once.
#
# From Google Cloud Console -> APIs & Services -> Credentials -> an OAuth
# 2.0 Client ID of type "Web application". See docs/deploying.md for the
# full walkthrough, including the exact redirect URIs to register.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments (Razorpay) -------------------------------------------------
# All three optional. With them unset the storefront runs normally and
# checkout reports that payment is unavailable — there is no unsafe
# fallback here, so unlike MSG91 the app does NOT refuse to boot without
# them. That is deliberate: gateway KYC takes days, and a deploy has to
# stay up while it is pending.
#
# KEY_ID is handed to the browser to open the checkout and is not secret.
# KEY_SECRET authenticates server-to-server calls and must never reach the
# client. Both come from Razorpay Dashboard → Settings → API Keys; use the
# `rzp_test_` pair until the account is activated.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Signs webhook deliveries. Set when you create the webhook under
# Settings → Webhooks, and unrelated to KEY_SECRET above. Without it every
# webhook is rejected, which means orders are created and paid for but
# never marked paid — so this is the one to check first when a test
# payment succeeds and the order stays PENDING_PAYMENT.
#
# Subscribe the webhook to `payment.captured` and `payment.failed`.
RAZORPAY_WEBHOOK_SECRET=""

# The site's own origin, used for the absolute URLs that Open Graph images
# and canonical links require. Optional: on Vercel this falls back to
# VERCEL_PROJECT_PRODUCTION_URL and then to VERCEL_URL, and to
# http://localhost:3000 in development. Set it explicitly on a custom
# domain, where those Vercel variables name the deployment, not the site.
SITE_URL=""

# --- Object storage (Supabase Storage) ------------------------------------
# All four optional, and — like Razorpay above — with them unset the app
# runs normally and uploads simply report themselves as unavailable rather
# than refusing to boot. Backs the Parcha workbench's file picker and
# camera capture today; project documents and product images later.
#
# Selects which StorageProvider implementation src/lib/storage/index.ts
# uses. Supabase is the only one implemented and is the default when this
# is unset, so leaving it blank is fine.
STORAGE_PROVIDER="supabase"

# The project's API URL, e.g. https://xxxxx.supabase.co — same project as
# DATABASE_URL above, found on the same dashboard page.
SUPABASE_URL=""

# Bypasses row-level security entirely for every bucket and every row.
# Treat it exactly like RAZORPAY_KEY_SECRET: server-only, never sent to
# the client, never logged, never returned in a response body. This is
# what lets the server mint a signed upload/download URL scoped to one
# object on a customer's behalf without that customer holding a Supabase
# credential of their own. Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# The bucket every StoredFile row is written against. Must be created as
# a PRIVATE bucket — nothing in this app is ever served from a public
# Supabase Storage URL; every read is a short-lived signed URL minted
# server-side for the file's owner or for staff.
SUPABASE_STORAGE_BUCKET="quoin-uploads"

# The PUBLIC bucket, and the one exception to the line above. Catalogue
# imagery is the same picture served to everyone across a grid of tiles,
# so it is read straight from a public URL and cached at the edge — a
# signed URL would expire, defeat the CDN, and put a round-trip in front
# of every thumbnail. It is a SEPARATE bucket, never a public corner of
# the one above, so nothing a customer uploads can land in it by mistake.
# Created by `npx tsx scripts/upload-catalogue-images.ts`.
SUPABASE_PUBLIC_BUCKET="quoin-catalogue"

# --- Studio video (Cloudflare Stream) ------------------------------------
# Where Studio's clips are played from. All three optional: with them unset
# a pin whose clip is a Stream id renders as its poster with no player, and
# a clip shipped under public/studio/ plays with none of this set at all.
#
# CUSTOMER_CODE is the subdomain in customer-<code>.cloudflarestream.com,
# copied from any embed URL in the dashboard. It is NOT a secret - it is in
# every manifest URL the browser fetches - and it is the only one playback
# needs.
#
# ACCOUNT_ID and API_TOKEN are the upload side: minting a direct-upload URL
# so an architect's clip goes from their browser to Cloudflare without
# passing through Vercel. The token is a write credential for the whole
# Stream account. Treat it like SUPABASE_SERVICE_ROLE_KEY.
CF_STREAM_CUSTOMER_CODE=""
CF_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
#
# SERVER ONLY. Authenticates `/api/v1/cron/*` and the detail half of
# `/api/v1/health`. Vercel Cron sends it as `Authorization: Bearer <value>`
# on every scheduled invocation once it is set on the project; the same
# header works from curl for a manual run.
#
# Generate with:  openssl rand -base64 32
#
# Unset means the jobs refuse every caller and the health endpoint answers
# only `{ "ok": true }` — fail closed, deliberately. Two of those jobs
# matter: `reconcile-payments` is the only thing that recovers a payment
# whose webhook was lost, and `release-reservations` is the only thing that
# gives back stock an abandoned checkout is holding. Set it.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# WhatsApp order notifications (WhatsApp Business Cloud API)
# ---------------------------------------------------------------------------
#
# The official Meta API, and nothing else. There is no browser automation
# here, no QR-code session, no unofficial gateway and no personal WhatsApp
# account: all of those are against WhatsApp's terms, get the number banned,
# and cannot be run from a serverless function anyway.
#
# All of these are OPTIONAL and there is no boot guard. With them unset the
# app boots, orders are placed, paid, dispatched and delivered exactly as
# before, and every notification that could not be sent is written to
# `whatsapp_notifications` as FAILED with "WhatsApp is not configured" on it
# — visible on the admin order page and retryable with one click once the
# credentials land. That matters because Meta's business verification plus
# six template reviews take days, the same way gateway KYC does.
#
# Full setup, template bodies and the {{n}} positions each one expects:
#   docs/whatsapp-orders.md
#
# WhatsApp Manager -> API Setup. The id of the business number that sends.
# Not the phone number itself, and not the WhatsApp Business Account id.
WHATSAPP_PHONE_NUMBER_ID=""

# SERVER ONLY. A permanent System User token with `whatsapp_business_messaging`
# (Business Settings -> System Users -> Generate new token). It can send as
# the business number, so treat it exactly like SUPABASE_SERVICE_ROLE_KEY:
# never NEXT_PUBLIC_, never in a response body, never in a log line.
#
# Do NOT use the 24-hour temporary token from the API Setup page for anything
# but a first smoke test - it expires and messages then silently fail.
WHATSAPP_ACCESS_TOKEN=""

# Graph API version. Optional; defaults to v21.0. A variable rather than a
# constant because Meta retires versions on its own schedule.
WHATSAPP_API_VERSION=""

# The language code the six templates were approved under. Optional;
# defaults to "en". Set it to "en_US" if that is what the dashboard shows -
# a mismatch here is the single commonest cause of "Template name does not
# exist in the translation", which is a FAILED notification and no message.
WHATSAPP_TEMPLATE_LANGUAGE=""

# "template" (the default and the only production answer) or "text".
#
# "text" sends the message body as free-form text instead of a template,
# which WhatsApp only delivers inside a 24-hour window the recipient opened
# by messaging the business first. Useless for real customers; exactly right
# for the days between wiring this up and six templates clearing review -
# message your own business number, then drive the whole lifecycle.
WHATSAPP_MESSAGE_MODE=""

# Answers Meta's GET verification challenge when the delivery-status webhook
# is first subscribed. You choose the value; type the same one into
# Meta app -> WhatsApp -> Configuration -> Webhook, pointed at
#   https://<your-domain>/api/v1/webhooks/whatsapp
#
# Generate with:  openssl rand -base64 32
# Unset, that route refuses to verify - fail closed, like CRON_SECRET.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# SERVER ONLY. The Meta APP SECRET (App Settings -> Basic), which signs every
# webhook delivery as X-Hub-Signature-256. NOT the access token above: a
# deploy can hold a valid sending token and still be unable to trust a single
# incoming delivery, which is why this is its own variable.
#
# Unset, the delivery-status webhook rejects every request rather than
# trusting whatever a public URL is posted. Sending still works without it;
# only the "the provider later said this message failed" reporting is lost.
WHATSAPP_APP_SECRET=""
