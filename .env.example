# Copy to .env.local and fill in. Never commit .env.local.

# Postgres — the pooled connection string. On Supabase that is the
# Supavisor URL on port 6543, with ?pgbouncer=true.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# The same database, reached directly on 5432. Used by `prisma migrate`
# only, never at request time: Supavisor's transaction mode drops the
# prepared statements a migration needs. Required whenever the schema
# declares `directUrl` — `prisma generate` does not need it, so the
# deployed build is unaffected, but `prisma migrate deploy` is.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Signs session JWTs and peppers OTP hashes. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# --- SMS delivery (MSG91) ------------------------------------------------
# Optional in development: with these unset, login codes are printed to the
# server log instead of being sent. The app refuses to boot in production
# without MSG91_AUTH_KEY, so that can never happen on a deployed instance.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# --- Competitor imagery (demo only) --------------------------------------
# Renders the product photography captured in Product.sourceImageUrl.
#
# Those images belong to the sites they were scraped from and to the
# manufacturers, and serving them hotlinks someone else's CDN. Fine behind
# a private demo link; not something to leave on for a public storefront.
# Unset or "0" keeps the generated swatches.
SHOW_SOURCE_IMAGES="0"

# --- Image generation (optional) ------------------------------------------
# Used only by `npm run images:generate`, never at request time. Anthropic
# has no image model, so this is a third-party key.
#
# Everything the script writes is flagged as generated and labelled
# "Illustration - actual product may vary" in the storefront. These are
# illustrations of a category, not photographs of the SKU being sold.
OPENAI_API_KEY=""

# --- Payments (Razorpay) -------------------------------------------------
# All three optional. With them unset the storefront runs normally and
# checkout reports that payment is unavailable — there is no unsafe
# fallback here, so unlike MSG91 the app does NOT refuse to boot without
# them. That is deliberate: gateway KYC takes days, and a deploy has to
# stay up while it is pending.
#
# KEY_ID is handed to the browser to open the checkout and is not secret.
# KEY_SECRET authenticates server-to-server calls and must never reach the
# client. Both come from Razorpay Dashboard → Settings → API Keys; use the
# `rzp_test_` pair until the account is activated.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Signs webhook deliveries. Set when you create the webhook under
# Settings → Webhooks, and unrelated to KEY_SECRET above. Without it every
# webhook is rejected, which means orders are created and paid for but
# never marked paid — so this is the one to check first when a test
# payment succeeds and the order stays PENDING_PAYMENT.
#
# Subscribe the webhook to `payment.captured` and `payment.failed`.
RAZORPAY_WEBHOOK_SECRET=""
