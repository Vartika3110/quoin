# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Neon works well here — use the pooled connection string.
DATABASE_URL="postgresql://user:password@host/quoin?sslmode=require"

# Signs session JWTs and peppers OTP hashes. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# --- SMS delivery (MSG91) ------------------------------------------------
# Optional in development: with these unset, login codes are printed to the
# server log instead of being sent. The app refuses to boot in production
# without MSG91_AUTH_KEY, so that can never happen on a deployed instance.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""
