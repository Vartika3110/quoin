// Module 1 — identity, addresses and serviceability.
//
// Deliberately scoped: no catalogue, cart or order models yet. What is
// here is what every later module depends on — who the customer is, where
// they are, and whether Quoin can serve that location.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  /// Migrations only, and optional: unset, Prisma uses `url` for both.
  ///
  /// Supabase pools through Supavisor in transaction mode, which does not
  /// keep the prepared statements a migration needs, so `prisma migrate`
  /// has to reach the database directly on 5432 while the app keeps using
  /// the pooled 6543 URL. Neon's pooler does not need this, which is why
  /// it was absent while the database lived there.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserTier {
  STANDARD
  PRO
}

model User {
  id String @id @default(cuid())

  /// E.164, always normalised before it reaches the database (+919876543210).
  /// Storing raw user input here guarantees duplicate accounts.
  phone String  @unique
  name  String?
  email String? @unique

  /// Drives price resolution. A tier column rather than a boolean because
  /// trade/architect tiers are already implied by the storefront.
  tier UserTier @default(STANDARD)

  /// Paise, never rupees. Wallet is a running balance today; it becomes a
  /// derived sum over a ledger table when refunds and credits land.
  walletPaise Int @default(0)

  /// Access to the internal tools that change what the storefront sells.
  ///
  /// Deliberately not grantable through any route: it is set directly on
  /// the row, out of band, by someone with database access. An admin flag
  /// that some endpoint can flip is a privilege-escalation bug waiting
  /// for the endpoint that forgets to check who is asking.
  isStaff Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses          Address[]
  consultRequests    ConsultRequest[]
  orders             Order[]
  inventoryMovements InventoryMovement[]
  /// Every status change this account made as staff, across every order —
  /// not this account's own orders. Nullable on the other side: the
  /// account can be deleted without deleting the audit row it wrote.
  orderStatusChanges OrderStatusChange[]
  storedFiles        StoredFile[]
  parchaSubmissions  ParchaSubmission[]

  @@map("users")
}

enum AddressLabel {
  HOME
  WORK
  /// A construction site — often has no formal address, hence `landmark`.
  SITE
  OTHER
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label    AddressLabel @default(HOME)
  line1    String
  line2    String?
  landmark String?
  city     String
  state    String
  pincode  String

  /// Serviceability is decided by coordinates, never by pincode. Pincodes
  /// straddle store radii and would make the 18-minute promise a lie.
  lat Float
  lng Float

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([userId])
  @@map("addresses")
}

/// A pending phone verification. Rows are kept after use rather than
/// deleted so that rate limiting can see recent history per phone.
model OtpChallenge {
  id    String @id @default(cuid())
  phone String

  /// HMAC of the code, never the code itself. A support engineer reading
  /// the table must not be able to log in as a customer.
  codeHash String

  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// A dark store. Serviceability and the delivery promise are computed
/// against these, so `instant` fulfilment is only ever offered where a
/// store can actually reach the customer.
model Store {
  id   String @id @default(cuid())
  code String @unique
  name String

  lat Float
  lng Float

  /// Straight-line kilometres. Road distance is what actually matters, so
  /// this is intentionally conservative until routing is wired in.
  serviceRadiusKm Float @default(6)

  /// The headline promise for in-stock items from this store.
  baseEtaMinutes Int @default(18)

  isActive Boolean @default(true)

  /// The locality this store serves, when it maps cleanly onto one.
  ///
  /// Serviceability is still decided by distance — the radius is what
  /// makes the promise true — but a customer picks an area by name, and
  /// this is what turns that choice into a store and an ETA.
  serviceAreaId String?      @unique
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)

  /// Where a tracked `SCHEDULED` line's stock is reserved from when the
  /// delivery address falls outside every store's radius — heavy/bulk
  /// goods still need a real warehouse to ship from even when nothing is
  /// nearby. Meaningless for `INSTANT`, which has no fallback: see
  /// `resolveStoreForStockLine` in src/lib/data/inventory.ts.
  ///
  /// Not enforced as at-most-one by the schema — a second row marked
  /// default only makes the fallback pick whichever `findFirst` returns,
  /// it does not corrupt anything — but the operator is expected to keep
  /// exactly one active store flagged.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@map("stores")
}

/// ---------------------------------------------------------------------
/// Catalogue — module 2.
///
/// Ported from the Django `catalog` app, which has been removed. The
/// decisions carried over unchanged: money in integer paise, fulfilment
/// modelled per product rather than assumed, and imported provenance
/// quarantined behind `source*` fields that are reference data for
/// pricing and are never rendered to a customer.
/// ---------------------------------------------------------------------

/// How a listing reaches the customer. Drives cart splitting at checkout.
enum Fulfilment {
  /// In a dark store within a `Store` radius. The "18 minutes" promise.
  INSTANT
  /// Real stock, delivered on a chosen date — heavy or bulk goods.
  SCHEDULED
  /// No stock at all. Consumes a professional's time slot.
  BOOKABLE
  /// Cut or manufactured after the order is placed.
  MADE_TO_ORDER
}

/// How the price is expressed to the customer. Drives the add-to-cart UI.
enum PricingUnit {
  PER_PIECE
  PER_SQFT
  PER_RUNNING_FT
  PER_VISIT
  PER_BAG
  PER_LITRE
  PER_KG
}

/// Trust markers rendered as chips on product cards.
enum BadgeKind {
  EXPERTS_VERIFIED
  PREMIUM_QUALITY
  TOP_BRAND
  PREMIUM_FINISH
  BESTSELLER
}

model Brand {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Self-referential tree. Restrict rather than cascade: deleting a
  /// parent must never silently delete the products filed beneath it.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  /// Swatch keys composited into the storefront category tile. Real
  /// artwork replaces these; the column holds keys, not URLs, so the
  /// fallback renderer keeps working until photography exists.
  images String[] @default([])

  /// Manual sort order on the storefront; ties break by name.
  position Int     @default(0)
  isActive Boolean @default(true)

  products        Product[]
  consultRequests ConsultRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id   String @id @default(cuid())
  sku  String @unique
  name String
  slug String @unique

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  description String @default("")

  fulfilment  Fulfilment  @default(SCHEDULED)
  pricingUnit PricingUnit @default(PER_PIECE)

  /// GST slab as a percentage: 0, 5, 12, 18 or 28. An integer rather than
  /// an enum because it is arithmetic on every invoice line, and an enum
  /// would only be unwrapped back to a number at each use.
  gstRatePct Int @default(18)

  badges BadgeKind[] @default([])

  /// Quoin's own image: a URL, empty until one exists. Takes precedence
  /// over everything else the storefront could draw.
  image String @default("")

  /// True when `image` came from an image model rather than a camera.
  ///
  /// Load-bearing, not bookkeeping: a generated picture of a real SKU has
  /// to be labelled as an illustration wherever it appears, or the
  /// storefront is telling a customer they will receive something nobody
  /// has photographed. The storefront reads this to render that label.
  imageIsGenerated Boolean @default(false)

  /// Meaningful only for `SCHEDULED` and `MADE_TO_ORDER`.
  leadTimeDays Int?

  isActive Boolean @default(true)

  /// Whether stock is checked, reserved and deducted for this product's
  /// variants at all. Default false because the catalogue is thousands of
  /// imported SKUs with no stock data whatsoever — requiring an
  /// `InventoryItem` before anything could be sold would take the whole
  /// storefront offline the moment inventory ships. Set by hand by
  /// merchandising as real stock is counted in for a line; the importers
  /// must never set this. Only `INSTANT` and `SCHEDULED` fulfilment ever
  /// consults it — see `isStockBearing` in src/lib/data/inventory.ts.
  stockTracked Boolean @default(false)

  variants ProductVariant[]

  /// ---- provenance: reference only, never customer-facing ------------
  /// Where an imported row came from and what the competitor charged.
  /// Never rendered, never treated as Quoin stock or imagery.
  sourceName         String?
  sourceUrl          String?
  sourceImageUrl     String?
  sourceAvailability String?
  sourcePricePaise   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([brandId])
  @@map("products")
}

/// A purchasable option. Every product has at least one. Products with
/// more than one display the cheapest as "₹X Onwards" rather than an
/// exact price — see `resolvePrice()` in src/lib/types/catalog.ts.
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label String @default("Standard")
  sku   String @unique

  /// List price before discount.
  mrpPaise      Int
  /// Sell price for a standard customer.
  pricePaise    Int
  /// Quoin Pro trade rate. Null means Pro pays `pricePaise`.
  proPricePaise Int?

  /// Marble is not sold by the single sq.ft., nor cement by the bag.
  minQty  Int @default(1)
  stepQty Int @default(1)

  isDefault Boolean @default(true)
  isActive  Boolean @default(true)

  priceTiers     PriceTier[]
  inventoryItems InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

/// Volume break. Contractors buy cement by the hundred bags.
model PriceTier {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  minQty Int
  /// Null means no upper bound.
  maxQty Int?

  pricePaise Int

  @@unique([variantId, minQty])
  @@index([variantId])
  @@map("price_tiers")
}

/// A named locality Quoin serves, with the pincodes that reach it.
///
/// Deliberately *not* the source of truth for the delivery promise —
/// `Store.serviceRadiusKm` still decides that, because a pincode straddles
/// store radii and half of 110063 can be outside the eighteen minutes
/// while the other half is inside. This table answers a different and
/// coarser question: "do you operate in my area at all", which is what a
/// customer types a pincode into a box to find out, and it gives that
/// area a name to show back to them.
model ServiceArea {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  city  String @default("New Delhi")
  state String @default("Delhi")

  /// Cleared to switch an area off without deleting its pincodes.
  isActive Boolean @default(true)

  pincodes        ServicePincode[]
  store           Store?
  consultRequests ConsultRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_areas")
}

/// One postal code, belonging to exactly one serviceable area.
///
/// `pincode` is unique: a code that mapped to two areas would make the
/// lookup ambiguous at the only moment it is used, and the customer would
/// get whichever row the database happened to return first.
model ServicePincode {
  id String @id @default(cuid())

  pincode String @unique

  areaId String
  area   ServiceArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([areaId])
  @@map("service_pincodes")
}

/// ---------------------------------------------------------------------
/// Inventory — module 7.
///
/// Only `Product.stockTracked` products ever touch this. Everything else
/// sells exactly as it did before this module existed: no `InventoryItem`
/// row, no check, no reservation. See the module comment in
/// src/lib/data/inventory.ts for why that is the deliberate design rather
/// than a gap.
/// ---------------------------------------------------------------------

enum InventoryMovementKind {
  /// Stock arrives. `onHandQty` only.
  RECEIPT
  /// An order is created. `reservedQty` only — nothing has left the
  /// shelf yet, it is merely spoken for.
  RESERVE
  /// A reservation is given back: payment failed and the customer moved
  /// on, the reservation expired, or the order was cancelled.
  /// `reservedQty` only.
  RELEASE
  /// `payment.captured`. The stock that was reserved is now actually
  /// gone — both `onHandQty` and `reservedQty` move together, because a
  /// commit is a release-and-deduct in one step, not a release followed
  /// by a separate deduction that could be individually replayed.
  COMMIT
  /// A staff correction — a stock count, a breakage, a miscount found on
  /// audit. `onHandQty` only, and the only kind whose `qty` can be
  /// negative.
  ADJUSTMENT
  /// A customer returned goods. `onHandQty` only. Deliberately separate
  /// from `ADJUSTMENT`: a return is explained by the order it came back
  /// against, a correction is not explained by anything but a person.
  RETURN
}

/// Stock for one variant at one store. Per `(variantId, storeId)` because
/// the same SKU can sit in more than one dark store, each with its own
/// count and its own reservations against it.
///
/// There is no `availableQty` column. `onHandQty - reservedQty` is the
/// available count, computed at read time by `availableQty` in
/// src/lib/data/inventory.ts — a stored third number is a number that can
/// disagree with the two it summarises, and the disagreement always
/// surfaces as a customer being told something is in stock when it is
/// not.
model InventoryItem {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  /// Physically on the shelf, spoken for or not.
  onHandQty   Int @default(0)
  /// Held against `PENDING_PAYMENT` orders that have not yet been
  /// committed or released. Not yet gone — see `COMMIT` above.
  reservedQty Int @default(0)

  /// Below this, the storefront shows a low-stock warning. Merchandising
  /// data, not a sellability gate: a line at or under threshold is still
  /// sellable for as long as `onHandQty - reservedQty` stays positive.
  lowStockThreshold Int @default(0)

  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The row a reservation targets, and what makes "one row per variant
  /// per store" true rather than aspirational. The conditional reserve
  /// update in src/lib/data/inventory.ts looks this row up by exactly
  /// this pair.
  @@unique([variantId, storeId])
  @@index([storeId])
  @@map("inventory_items")
}

/// One movement of stock, append-only and never edited. Every reserve,
/// release, commit, receipt, adjustment and return writes exactly one
/// row here, carrying the *resulting* `onHandQty` and `reservedQty` —
/// not only the delta — so the history of one item is reconstructible
/// from this table alone rather than merely suggestive of what happened.
model InventoryMovement {
  id String @id @default(cuid())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  kind InventoryMovementKind

  /// A positive magnitude for every kind except `ADJUSTMENT`, which can
  /// be negative — a correction can go either way. Which counter it moves,
  /// and which direction, is decided by `kind` alone: see `movementDelta`
  /// in src/lib/data/inventory.ts, the one place that arithmetic lives.
  qty Int

  /// State *after* this movement was applied.
  onHandQty   Int
  reservedQty Int

  /// Not a foreign key. `RECEIPT` and `ADJUSTMENT` movements have no order
  /// at all, and an `Order` row is never deleted (Restrict everywhere it is
  /// referenced), so a real relation would add ceremony without changing
  /// what a dispute can reconstruct from this table.
  ///
  /// `RETURN` does carry one: `returnStock()` requires the order the goods
  /// came back against, because stock reappearing on a shelf with nothing
  /// saying where it came from is the movement a stock-take cannot explain.
  orderId String?

  /// Required by the application for `ADJUSTMENT`, meaningless for every
  /// other kind. Not a NOT NULL column: that constraint would have to be
  /// conditional on `kind`, and a Postgres check constraint for one call
  /// site is more ceremony than the app-level guard already carries.
  reason String?

  /// Who made an `ADJUSTMENT`. SetNull, matching `ConsultRequest.userId`:
  /// losing the name off a correction made by an account that no longer
  /// exists costs far less than blocking the account's deletion on it.
  staffUserId String?
  staffUser   User?   @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Stock history for one item, read newest-first.
  @@index([inventoryItemId, createdAt])
  @@map("inventory_movements")
}

/// ---------------------------------------------------------------------
/// Consultations — the first slice of module 6.
///
/// A consultation is not a booking. Nothing here reserves a professional's
/// time, because there is no professional roster to reserve from yet: the
/// customer states a mode, a day and a half-day window they would prefer,
/// and Quoin calls back to confirm. The model is shaped around that
/// honesty — `preferredDate`/`preferredSlot` are a request, and `status`
/// only reaches `SCHEDULED` when a human has actually agreed a time.
///
/// When the roster lands, a `ConsultBooking` joins this table to a
/// professional and a real slot. This row stays what it is: the demand.
/// ---------------------------------------------------------------------

/// How the expert meets the customer.
enum ConsultMode {
  /// A scheduled video call. Costs Quoin nothing but the expert's time,
  /// so it is the free one, and it cannot measure anything.
  VIDEO
  /// An expert at the site. The only mode that can measure, survey and
  /// quote real work, and the only one that is chargeable.
  SITE_VISIT
}

/// The half-day window a customer asks for.
///
/// Deliberately coarse. An exact time would be a promise nothing in the
/// system can keep — there is no roster, no travel time and no capacity
/// model — and a slot picker that offers "11:30" implies all three.
enum ConsultSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum ConsultStatus {
  /// Submitted by the customer, nobody has called back yet.
  REQUESTED
  /// A time has been agreed with the customer by a human.
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ConsultRequest {
  id String @id @default(cuid())

  /// The code the customer is shown and reads out on the phone. Generated
  /// from an alphabet with no O/0 or I/1 for exactly that reason.
  reference String @unique

  mode   ConsultMode
  status ConsultStatus @default(REQUESTED)

  name String

  /// E.164, normalised by `normalizePhone` before it gets here — the same
  /// treatment auth gives it, so a customer who later signs in with the
  /// same number matches this row rather than sitting beside it.
  ///
  /// Unverified: no OTP is required to ask for a call back, because
  /// demanding one at the top of the funnel loses the customer at the only
  /// step that matters. Rate limiting on this column is what keeps that
  /// affordable — see the POST handler.
  phone String

  email String?

  /// Set when the request came from a signed-in session. Null is the
  /// ordinary case today; the storefront has no sign-in screen yet.
  ///
  /// SetNull rather than Cascade: a deleted account must not silently take
  /// an outstanding site visit off the operations list.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Where the work is. The area is the coarse locality Quoin operates in;
  /// the pincode is what the customer actually knows about their site, and
  /// is kept as text because a consultation may be asked for from outside
  /// the serviceable list — that is a lead, not an error.
  areaId  String?
  area    ServiceArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  pincode String?

  /// What the project is about, when it maps onto one catalogue category.
  /// SetNull rather than Restrict: `notes` carries the intent in the
  /// customer's own words, so losing the tidy label costs little, and a
  /// retired category must not block itself from being retired.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  notes String?

  /// The day asked for. `@db.Date` because this is a calendar day in the
  /// customer's head, not an instant — storing it as a timestamp would put
  /// a request for the 3rd on the 2nd for anyone reading it in UTC.
  preferredDate DateTime?    @db.Date
  preferredSlot ConsultSlot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Rate limiting reads by phone and recency; ops reads the queue by
  /// status and recency. Both are the hot paths, so both are indexed.
  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@map("consult_requests")
}

/// ---------------------------------------------------------------------
/// Orders and payments.
///
/// Everything above this line is reproducible from the files in this repo
/// — the catalogue can be dropped and re-imported. Nothing below it is.
/// An order is a record of money that moved, so these tables are
/// append-mostly and snapshot what they reference rather than pointing at
/// it: a price edited in the admin, a variant retired, or an address
/// corrected next month must not rewrite what a customer was charged.
/// ---------------------------------------------------------------------

/// Payment lifecycle, then fulfilment, then refund — in that order, because
/// none of the fulfilment statuses can be reached without a captured
/// payment and a refund can only start from one.
///
/// Everything from `CONFIRMED` onward is set by a person in an admin tool
/// that does not exist yet — see `canTransition` in `src/lib/data/orders.ts`,
/// which is the guard, not an endpoint. Only `PAID` may be set by anything
/// other than a person, and only `payment.captured` sets it.
enum OrderStatus {
  /// Written before the customer is sent to the gateway. Rows can sit
  /// here forever: an abandoned checkout is the ordinary case, not an
  /// error, and it is the only evidence that the attempt happened.
  PENDING_PAYMENT
  /// The webhook confirmed a captured payment for the full amount. This
  /// is the only status that may be set by anything other than a person,
  /// and only `payment.captured` sets it.
  PAID
  /// The gateway reported the attempt failed. Not terminal — the customer
  /// can pay the same order again, which is why `Payment` is a separate
  /// table.
  FAILED
  CANCELLED
  /// A person has looked at a paid order and accepted it for fulfilment.
  CONFIRMED
  /// Being picked and prepared.
  PROCESSING
  /// Picked, prepared and boxed, waiting to leave a store.
  PACKED
  /// Left the store, not yet with the last-mile courier or rider.
  DISPATCHED
  /// With the rider or courier on the final leg.
  OUT_FOR_DELIVERY
  /// Handed to the customer. Terminal for fulfilment, but not for money —
  /// a delivered order can still be refunded.
  DELIVERED
  /// A refund has been agreed but not yet processed by the gateway.
  REFUND_PENDING
  /// The gateway has returned the money. Terminal.
  REFUNDED
}

model Order {
  id String @id @default(cuid())

  /// The code the customer quotes on the phone. Same alphabet as
  /// `ConsultRequest.reference` and for the same reason — it is read
  /// aloud — with a different prefix so support can tell at a glance
  /// whether they are looking at an order or a consultation.
  reference String @unique

  /// Orders require an account. A guest order would have nowhere to send
  /// the invoice and no way to prove ownership when the customer calls
  /// about it, and the phone number behind a session is already verified.
  ///
  /// Restrict, not Cascade: deleting a user must not delete the financial
  /// record of what they paid. Closing an account is an anonymisation
  /// problem, not a deletion one.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status OrderStatus @default(PENDING_PAYMENT)

  /// A client-supplied token that makes order creation safe to retry.
  ///
  /// Scoped to the user, not global: two different customers choosing the
  /// same key by coincidence (a client that seeds it from `Date.now()`,
  /// say) must not collide, so the uniqueness is `(userId, idempotencyKey)`
  /// rather than on this column alone. Optional — Postgres does not treat
  /// two NULLs as equal for a unique index, so orders placed without a key
  /// never collide with each other.
  idempotencyKey String?

  /// ---- money, all paise, all server-computed --------------------------
  /// Recomputed by `quoteCart` at the moment the order is written and
  /// never taken from the browser. The gateway is told `totalPaise`, and
  /// the webhook checks what was captured against it before marking the
  /// order paid.
  ///
  /// Catalogue prices are tax-*inclusive* — see the note on `taxForLine`
  /// in `src/lib/data/orders.ts` — so `subtotalPaise` is exactly what the
  /// customer is charged for the lines, before `discountPaise` and
  /// `deliveryFeePaise` are applied.
  subtotalPaise    Int
  /// Sum of the per-line GST, which is itself computed from each
  /// product's `gstRatePct`. A *component of* `subtotalPaise`, already
  /// contained within it, not an amount added on top. Stored rather than
  /// derived so that a rate corrected in the catalogue next quarter does
  /// not restate an invoice that has already been issued.
  taxPaise         Int
  /// No discount or delivery-fee engine exists yet — both default to zero
  /// so a later phase has a column to write to rather than a schema
  /// change blocking it. Neither is computed anywhere in this codebase.
  discountPaise    Int    @default(0)
  deliveryFeePaise Int    @default(0)
  /// `subtotalPaise - discountPaise + deliveryFeePaise`. Not
  /// `subtotal + tax`: tax is already inside the subtotal, and adding it
  /// again is the double-charge this schema exists to stop happening.
  totalPaise       Int
  /// Not selectable by the customer today — every order is INR — but
  /// carried on the row rather than assumed at read time, because an
  /// amount without its currency is not a complete financial record.
  currency         String @default("INR")

  /// ---- delivery address, snapshotted ----------------------------------
  /// Copied rather than joined. `Address` rows are editable, and a
  /// customer fixing a typo in their flat number must not change the
  /// address a delivered order says it went to.
  addressId    String?
  address      Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shipName     String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipLandmark String?
  shipCity     String
  shipState    String
  shipPincode  String

  lines         OrderLine[]
  payments      Payment[]
  statusChanges OrderStatusChange[]

  /// Set at creation only when at least one line actually reserved stock
  /// — see `createPendingOrder`. Null means either nothing in the basket
  /// is stock-tracked, or the reservation has already been released or
  /// committed, in both cases meaning there is nothing left to expire.
  ///
  /// Nothing in this app sweeps this column on its own — see
  /// `releaseExpiredReservations` in src/lib/data/inventory.ts. Something
  /// has to call it; there is no cron infrastructure here to do that for
  /// you.
  reservationExpiresAt DateTime?

  /// Set once, by the webhook, when the first capture lands. A second
  /// delivery of the same event must not move it.
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The arbiter for a double-clicked pay button. A repeat key for the
  /// same user returns the order this index found rather than creating
  /// another — decided by the database on insert, not by a `findFirst`
  /// beforehand, so two concurrent requests carrying the same key cannot
  /// both pass the check and both create a row.
  @@unique([userId, idempotencyKey])
  /// The account area lists a customer's own orders newest first; ops
  /// reads the queue by status.
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

/// One purchased line, frozen.
///
/// No foreign key to `ProductVariant`. That is deliberate and it is the
/// whole point of this table: variants are retired, renamed and repriced,
/// and an order line must keep saying what was bought and what it cost
/// even after the SKU stops existing. `variantId` and `productSlug` are
/// kept as plain strings so support can still find the catalogue row when
/// it is there, without the database being able to change this one.
model OrderLine {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productSlug  String
  variantId    String
  sku          String
  /// The name as it read on the day, not as it reads now.
  title        String
  variantLabel String

  qty            Int
  unitPricePaise Int
  /// Struck-through price at the time, when there was a saving to show.
  mrpPaise       Int?
  /// `unitPricePaise * qty`, before tax.
  linePaise      Int

  /// The slab this line was taxed at, copied from `Product.gstRatePct`.
  gstRatePct Int
  /// GST on this line, computed from `linePaise` and `gstRatePct`.
  taxPaise   Int

  /// Copied from the product so the order can still be split by how it
  /// reaches the customer once the catalogue has moved on.
  fulfilment Fulfilment

  /// The store stock was reserved from, for a tracked `INSTANT` or
  /// `SCHEDULED` line. Null for every other line — untracked, or
  /// `BOOKABLE`/`MADE_TO_ORDER`, which never hold stock at all.
  ///
  /// Not a foreign key, matching `variantId` above: this table freezes
  /// what happened, and `Store` is operational data that can be
  /// deactivated later without that rewriting which store a past order
  /// actually reserved against. It is what `settleCapturedPayment` and
  /// `releaseExpiredReservations` use to commit or release the *same*
  /// `InventoryItem` that was reserved — see src/lib/data/inventory.ts.
  storeId String?

  @@index([orderId])
  @@map("order_lines")
}

/// One admin action against `Order.status`, kept forever.
///
/// Changing the state of something a customer paid for without recording
/// who did it is not acceptable in a system that handles money — this is
/// the "who" that `Order.status` alone cannot answer. Written in the same
/// transaction as the status write it describes (see
/// `transitionOrderStatus`, `src/lib/data/admin-orders.ts`), so a status
/// change and its audit row cannot come apart: either both exist or
/// neither does.
model OrderStatusChange {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus
  toStatus   OrderStatus

  /// Nullable, deliberately: a future automated transition (there is only
  /// one today, the webhook's own move to PAID, and that path does not
  /// write this table at all — see the note on `transitionOrderStatus`)
  /// should be attributable to nobody rather than to a fiction. SetNull
  /// rather than Restrict: the staff account being deactivated or removed
  /// later must not delete the record that the change happened, only the
  /// name attached to it.
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())

  /// The order detail page reads its own history newest-first.
  @@index([orderId, createdAt])
  @@map("order_status_changes")
}

enum PaymentProvider {
  RAZORPAY
}

/// Mirrors the gateway's own vocabulary rather than inventing one.
/// Translating Razorpay's states into house terms would mean deciding
/// what `authorized` means here every time the mapping is read.
enum PaymentStatus {
  /// A gateway order exists and the customer has been handed to it.
  CREATED
  /// Funds held, not yet taken. Only appears when the account is set to
  /// manual capture; with auto-capture the next state is CAPTURED.
  AUTHORIZED
  /// Money taken. The only state that may mark an `Order` PAID.
  CAPTURED
  FAILED
  REFUNDED
}

/// One trip to the gateway.
///
/// The grain is a *checkout attempt*, not an `Order` and not a Razorpay
/// `payment_id`: a row is written when a gateway order is created and the
/// customer is handed to it. Someone who abandons and comes back a day
/// later gets a second gateway order and so a second row, which is what
/// keeps the abandoned attempt visible instead of overwriting it.
///
/// Retries *inside* one checkout modal — a UPI collect that expires and
/// is then paid by card — share Razorpay's order id and so share this
/// row, and the later `payment_id` replaces the earlier one on it. That
/// loses the failed attempt's id, which is a support inconvenience and
/// not an accounting one: the money is tracked by the capture, and the
/// failure reason is still written to `failureReason`.
model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  provider PaymentProvider @default(RAZORPAY)

  /// Razorpay's `order_id`, and the key the webhook looks a row up by —
  /// it is the only identifier that exists both before the customer has
  /// paid anything and on every event about it afterwards. Unique because
  /// exactly one gateway order is created per row.
  providerOrderId String @unique

  /// Razorpay's `payment_id`, null until the customer actually tries to
  /// pay. Unique, and that index is load-bearing: together with `status`
  /// it is how a repeat webhook delivery is recognised as one. Razorpay
  /// retries on any non-2xx and can deliver the same event twice even
  /// after a success, so settlement is written to be safe to run again
  /// rather than assumed to run once.
  providerPaymentId String? @unique

  /// What the gateway was asked for, in paise. Compared against the
  /// captured amount before an order is marked paid — a capture for less
  /// than the order total is a discrepancy, not a sale.
  amountPaise Int

  status PaymentStatus @default(CREATED)

  /// `upi`, `card`, `netbanking`, `wallet` — the gateway's own string,
  /// stored as text because the list is theirs to extend, not ours.
  method String?

  /// The gateway's failure description, kept verbatim for support. Shown
  /// to no one: these strings are written for integrators, not customers.
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

enum RefundStatus {
  /// Agreed but not yet sent to the gateway.
  PENDING
  /// The gateway has returned the money.
  PROCESSED
  FAILED
}

/// A refund against one payment. Model only, this phase — there is no
/// gateway refund call and no route that writes one. `Order.status`
/// carries `REFUND_PENDING`/`REFUNDED` for the coarse view; this table is
/// the money record underneath it, and it is keyed to `Payment` rather
/// than `Order` because a partial refund refers to a specific capture, not
/// to the order as a whole.
model Refund {
  id String @id @default(cuid())

  paymentId String
  /// Restrict, matching `Payment.order`: a refund is a financial record
  /// and deleting the payment it refers to must not delete it.
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  /// Razorpay's `refund_id`, null until a gateway call has actually been
  /// made. Unique for the same reason `providerPaymentId` is — it is what
  /// makes a repeat webhook delivery about the same refund recognisable.
  providerRefundId String? @unique

  amountPaise Int

  status RefundStatus @default(PENDING)

  /// Free text today because there is no refund-reason taxonomy yet —
  /// "damaged in transit" and "customer changed their mind" are both just
  /// this column until a reporting need forces them apart.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@map("refunds")
}

/// One delivery of a gateway webhook, kept whether or not it was acted on.
///
/// Purely an audit log — nothing reads this table to decide anything, so
/// writing to it must never be able to turn a delivery that would
/// otherwise have succeeded into a failure. See the try/catch around every
/// insert in the Razorpay route.
///
/// Rows are written for a rejected signature and an unhandled event type,
/// not only for the ones the app acted on: a disputed payment needs to be
/// reconstructable even when the reason it wasn't settled is "we never
/// recognised this delivery as ours".
model PaymentWebhook {
  id String @id @default(cuid())

  provider PaymentProvider @default(RAZORPAY)

  /// Razorpay's `x-razorpay-event-id` header — its own idempotency key for
  /// a delivery, distinct from `Payment.providerPaymentId` because one
  /// event can be delivered more than once. Null rather than required: a
  /// delivery with a bad signature is recorded before there is reason to
  /// trust anything about it, header included.
  eventId String? @unique

  event String

  /// Whether the HMAC check passed. Recorded even when false — a rejected
  /// signature is exactly the kind of delivery a dispute needs a record
  /// of, and it is why this column exists instead of only ever recording
  /// deliveries that were already trusted.
  signatureValid Boolean

  /// ---- what the delivery referred to, as plain strings ----------------
  /// Not foreign keys. A forged or malformed delivery can name an id that
  /// matches nothing in this database, and a webhook audit row must be
  /// writable regardless — a foreign key would make recording the delivery
  /// depend on the very lookup this table exists to be independent of.
  providerOrderId   String?
  providerPaymentId String?
  orderId           String?

  /// What the app did with it — `"recorded"`, `"duplicate"`, `"unknown"`,
  /// `"amount_mismatch"`, `"rejected_signature"` and so on. Free text
  /// rather than an enum: this is a log column read by a person
  /// reconstructing a dispute, not branched on by code.
  outcome String?
  /// Set when processing raised. The signature check and the event-type
  /// switch cannot throw, so this is populated only by a write that failed
  /// partway — the case the 500 in the route asks Razorpay to retry.
  error   String?

  /// The exact bytes Razorpay sent. Kept because reconstructing a disputed
  /// capture from the entity ids alone is not always enough — but Razorpay
  /// includes the payer's email and contact on the payment entity, so this
  /// column is customer PII and nothing outside this table's own writer
  /// may select it. No route reads or exposes `PaymentWebhook` rows.
  rawBody String?

  receivedAt  DateTime  @default(now())
  /// Null for a rejected signature — nothing was processed, so there is
  /// nothing to time.
  processedAt DateTime?

  /// Reconstructing a dispute starts from a gateway order id; the ops
  /// timeline for one is read newest-first.
  @@index([providerOrderId])
  @@index([receivedAt])
  @@map("payment_webhooks")
}

/// ---------------------------------------------------------------------
/// Files.
///
/// Nothing a customer uploads is kept on the application's filesystem.
/// Vercel's is ephemeral — it is gone at the end of the invocation and is
/// not shared between them — so a "saved" document would be a document
/// that vanishes. Bytes live in object storage; this table is the index.
/// ---------------------------------------------------------------------

enum StoredFileKind {
  /// A materials list a customer photographed or exported.
  PARCHA
  PROJECT_DOCUMENT
  PRODUCT_IMAGE
  OTHER
}

enum StoredFileStatus {
  /// A signed upload URL has been issued and the bytes may not exist yet.
  /// Rows can sit here forever: a customer who opens the picker and
  /// changes their mind is the ordinary case, not an error.
  PENDING
  /// Present in the bucket, and its type and size re-checked against what
  /// was declared when the URL was issued.
  STORED
  /// Issued and never uploaded, or uploaded as something other than what
  /// was declared.
  ABANDONED
}

model StoredFile {
  id String @id @default(cuid())

  /// Null for something staff uploaded that belongs to no customer — a
  /// product photograph. SetNull rather than Cascade: deleting an account
  /// must not silently orphan bytes that are still being paid for.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  kind   StoredFileKind
  status StoredFileStatus @default(PENDING)

  /// The path inside the bucket, and deliberately not a URL. Which
  /// provider and which bucket are environment configuration; a URL
  /// written into a row pins that row to whichever provider was live the
  /// day it was created, and re-pointing storage becomes a data migration.
  storageKey String @unique
  bucket     String

  /// Declared by the client when the upload URL was requested, then
  /// re-checked against the object itself before the row reaches STORED.
  /// A client that says "image/png" and sends 40MB of something else does
  /// not get to decide what this column says.
  contentType String
  sizeBytes   Int

  /// What the customer called it. Display only, and never used to build a
  /// storage path — a filename is attacker-controlled text, and joining
  /// one onto a path is how "../" gets into a key.
  originalName String

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  parchaSubmissions ParchaSubmission[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("stored_files")
}

/// ---------------------------------------------------------------------
/// Parcha.
///
/// A parcha is the handwritten materials list passed over a counter.
/// Typing or pasting one works end to end today and is parsed by
/// `parseParcha` in src/lib/parcha.ts. A photograph of one does not:
/// there is no OCR provider behind this app, and these tables are shaped
/// so that stays *visible* rather than papered over — a submission whose
/// file nobody can read sits in AWAITING_MANUAL_REVIEW, which is a true
/// statement about what happens next, instead of quietly producing
/// invented lines.
/// ---------------------------------------------------------------------

enum ParchaSource {
  /// Typed or pasted into the workbench.
  TYPED
  /// A file in object storage.
  UPLOAD
}

enum ParchaStatus {
  /// A file exists and nothing has read it yet.
  AWAITING_EXTRACTION
  /// A reader is running.
  EXTRACTING
  /// Lines exist and the customer has not confirmed them. The normal
  /// resting state for a typed list and for anything successfully read.
  NEEDS_REVIEW
  /// Stored, but nothing configured can read this kind of file. Not a
  /// failure and not a queue that drains itself — a person opens it.
  AWAITING_MANUAL_REVIEW
  /// A reader ran and could not produce lines. `extractionNote` says why.
  FAILED
  /// The customer has been through the lines and acted on them.
  COMPLETED
}

model ParchaSubmission {
  id String @id @default(cuid())

  /// Quoted on the phone, same alphabet as the order and consultation
  /// references and for the same reason — it gets read aloud.
  reference String @unique

  /// Null for a guest. Pricing a list is exactly what someone does before
  /// deciding whether to make an account, so this must not require one.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  source ParchaSource
  status ParchaStatus

  /// Set when `source` is UPLOAD.
  fileId String?
  file   StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  /// Set when `source` is TYPED — the list exactly as it was written, kept
  /// so a bad parse can be re-run without asking the customer to type it
  /// again.
  rawText String?

  /// Why extraction did not happen or did not work, in words a person can
  /// act on. Shown to staff, not to the customer.
  extractionNote String?

  /// HMAC of the caller's IP, and only ever set for a guest submission.
  ///
  /// This endpoint accepts anonymous writes on purpose — pricing a list is
  /// what someone does *before* making an account — which means the only
  /// thing standing between it and unbounded row creation is a rate limit,
  /// and a rate limit held in a process's memory is not one on a platform
  /// that runs each request on whichever instance is free. Counted off
  /// this column instead, the same way the OTP route counts off
  /// `OtpChallenge`.
  ///
  /// Hashed rather than stored: an IP address is personal data, the rate
  /// limiter only ever needs to ask "have I seen this one", and a hash
  /// answers that without the table becoming a log of who browsed the
  /// catalogue. Null for signed-in callers, who are counted by `userId` —
  /// there is no reason to collect it twice.
  ipHash String?

  items ParchaItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// When a reader finished, successfully or not.
  extractedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@map("parcha_submissions")
}

/// One line read off a list, and what the catalogue thinks it is.
model ParchaItem {
  id String @id @default(cuid())

  submissionId String
  submission   ParchaSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Order on the original list. A materials list is read top to bottom
  /// and the customer checks it against paper.
  position Int

  /// The line exactly as written, then what was searched for, mirroring
  /// `ParchaLine` in src/lib/parcha.ts.
  raw  String
  term String

  /// A Float, unlike every quantity that reaches a cart. This is a reading
  /// of what someone wrote — "2.5 kg", "12.75 sq.ft." — not a quantity
  /// being transacted. It is snapped onto the variant's integer grid by
  /// `normalizeQty` if and when the customer adds it to a basket.
  qty  Float
  unit String?

  /// The catalogue's best guess. Plain strings rather than relations, for
  /// the same reason `OrderLine` holds none: a match is a record of what
  /// was suggested on the day, and a retired SKU must not delete it or
  /// stop the row being read.
  matchedProductSlug String?
  matchedVariantId   String?

  /// 0-100. Null when nothing was matched at all, which is different from
  /// a confident match to nothing.
  confidence Int?

  /// The customer's decision. Null until they have looked at this line —
  /// distinct from `false`, which means they looked and said no.
  accepted Boolean?

  @@index([submissionId, position])
  @@map("parcha_items")
}
