// Module 1 — identity, addresses and serviceability.
//
// Deliberately scoped: no catalogue, cart or order models yet. What is
// here is what every later module depends on — who the customer is, where
// they are, and whether Quoin can serve that location.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  /// Migrations only, and optional: unset, Prisma uses `url` for both.
  ///
  /// Supabase pools through Supavisor in transaction mode, which does not
  /// keep the prepared statements a migration needs, so `prisma migrate`
  /// has to reach the database directly on 5432 while the app keeps using
  /// the pooled 6543 URL. Neon's pooler does not need this, which is why
  /// it was absent while the database lived there.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserTier {
  STANDARD
  PRO
}

model User {
  id String @id @default(cuid())

  /// E.164, always normalised before it reaches the database (+919876543210).
  /// Storing raw user input here guarantees duplicate accounts.
  phone String  @unique
  name  String?
  email String? @unique

  /// Drives price resolution. A tier column rather than a boolean because
  /// trade/architect tiers are already implied by the storefront.
  tier UserTier @default(STANDARD)

  /// Paise, never rupees. Wallet is a running balance today; it becomes a
  /// derived sum over a ledger table when refunds and credits land.
  walletPaise Int @default(0)

  /// Access to the internal tools that change what the storefront sells.
  ///
  /// Deliberately not grantable through any route: it is set directly on
  /// the row, out of band, by someone with database access. An admin flag
  /// that some endpoint can flip is a privilege-escalation bug waiting
  /// for the endpoint that forgets to check who is asking.
  isStaff Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses       Address[]
  consultRequests ConsultRequest[]

  @@map("users")
}

enum AddressLabel {
  HOME
  WORK
  /// A construction site — often has no formal address, hence `landmark`.
  SITE
  OTHER
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label    AddressLabel @default(HOME)
  line1    String
  line2    String?
  landmark String?
  city     String
  state    String
  pincode  String

  /// Serviceability is decided by coordinates, never by pincode. Pincodes
  /// straddle store radii and would make the 18-minute promise a lie.
  lat Float
  lng Float

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

/// A pending phone verification. Rows are kept after use rather than
/// deleted so that rate limiting can see recent history per phone.
model OtpChallenge {
  id    String @id @default(cuid())
  phone String

  /// HMAC of the code, never the code itself. A support engineer reading
  /// the table must not be able to log in as a customer.
  codeHash String

  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// A dark store. Serviceability and the delivery promise are computed
/// against these, so `instant` fulfilment is only ever offered where a
/// store can actually reach the customer.
model Store {
  id   String @id @default(cuid())
  code String @unique
  name String

  lat Float
  lng Float

  /// Straight-line kilometres. Road distance is what actually matters, so
  /// this is intentionally conservative until routing is wired in.
  serviceRadiusKm Float @default(6)

  /// The headline promise for in-stock items from this store.
  baseEtaMinutes Int @default(18)

  isActive Boolean @default(true)

  /// The locality this store serves, when it maps cleanly onto one.
  ///
  /// Serviceability is still decided by distance — the radius is what
  /// makes the promise true — but a customer picks an area by name, and
  /// this is what turns that choice into a store and an ETA.
  serviceAreaId String?      @unique
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stores")
}

/// ---------------------------------------------------------------------
/// Catalogue — module 2.
///
/// Ported from the Django `catalog` app, which has been removed. The
/// decisions carried over unchanged: money in integer paise, fulfilment
/// modelled per product rather than assumed, and imported provenance
/// quarantined behind `source*` fields that are reference data for
/// pricing and are never rendered to a customer.
/// ---------------------------------------------------------------------

/// How a listing reaches the customer. Drives cart splitting at checkout.
enum Fulfilment {
  /// In a dark store within a `Store` radius. The "18 minutes" promise.
  INSTANT
  /// Real stock, delivered on a chosen date — heavy or bulk goods.
  SCHEDULED
  /// No stock at all. Consumes a professional's time slot.
  BOOKABLE
  /// Cut or manufactured after the order is placed.
  MADE_TO_ORDER
}

/// How the price is expressed to the customer. Drives the add-to-cart UI.
enum PricingUnit {
  PER_PIECE
  PER_SQFT
  PER_RUNNING_FT
  PER_VISIT
  PER_BAG
  PER_LITRE
  PER_KG
}

/// Trust markers rendered as chips on product cards.
enum BadgeKind {
  EXPERTS_VERIFIED
  PREMIUM_QUALITY
  TOP_BRAND
  PREMIUM_FINISH
  BESTSELLER
}

model Brand {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Self-referential tree. Restrict rather than cascade: deleting a
  /// parent must never silently delete the products filed beneath it.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  /// Swatch keys composited into the storefront category tile. Real
  /// artwork replaces these; the column holds keys, not URLs, so the
  /// fallback renderer keeps working until photography exists.
  images String[] @default([])

  /// Manual sort order on the storefront; ties break by name.
  position Int     @default(0)
  isActive Boolean @default(true)

  products        Product[]
  consultRequests ConsultRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id   String @id @default(cuid())
  sku  String @unique
  name String
  slug String @unique

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  description String @default("")

  fulfilment  Fulfilment  @default(SCHEDULED)
  pricingUnit PricingUnit @default(PER_PIECE)

  /// GST slab as a percentage: 0, 5, 12, 18 or 28. An integer rather than
  /// an enum because it is arithmetic on every invoice line, and an enum
  /// would only be unwrapped back to a number at each use.
  gstRatePct Int @default(18)

  badges BadgeKind[] @default([])

  /// Quoin's own image: a URL, empty until one exists. Takes precedence
  /// over everything else the storefront could draw.
  image String @default("")

  /// True when `image` came from an image model rather than a camera.
  ///
  /// Load-bearing, not bookkeeping: a generated picture of a real SKU has
  /// to be labelled as an illustration wherever it appears, or the
  /// storefront is telling a customer they will receive something nobody
  /// has photographed. The storefront reads this to render that label.
  imageIsGenerated Boolean @default(false)

  /// Meaningful only for `SCHEDULED` and `MADE_TO_ORDER`.
  leadTimeDays Int?

  isActive Boolean @default(true)

  variants ProductVariant[]

  /// ---- provenance: reference only, never customer-facing ------------
  /// Where an imported row came from and what the competitor charged.
  /// Never rendered, never treated as Quoin stock or imagery.
  sourceName         String?
  sourceUrl          String?
  sourceImageUrl     String?
  sourceAvailability String?
  sourcePricePaise   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([brandId])
  @@map("products")
}

/// A purchasable option. Every product has at least one. Products with
/// more than one display the cheapest as "₹X Onwards" rather than an
/// exact price — see `resolvePrice()` in src/lib/types/catalog.ts.
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label String @default("Standard")
  sku   String @unique

  /// List price before discount.
  mrpPaise      Int
  /// Sell price for a standard customer.
  pricePaise    Int
  /// Quoin Pro trade rate. Null means Pro pays `pricePaise`.
  proPricePaise Int?

  /// Marble is not sold by the single sq.ft., nor cement by the bag.
  minQty  Int @default(1)
  stepQty Int @default(1)

  isDefault Boolean @default(true)
  isActive  Boolean @default(true)

  priceTiers PriceTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

/// Volume break. Contractors buy cement by the hundred bags.
model PriceTier {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  minQty Int
  /// Null means no upper bound.
  maxQty Int?

  pricePaise Int

  @@unique([variantId, minQty])
  @@index([variantId])
  @@map("price_tiers")
}

/// A named locality Quoin serves, with the pincodes that reach it.
///
/// Deliberately *not* the source of truth for the delivery promise —
/// `Store.serviceRadiusKm` still decides that, because a pincode straddles
/// store radii and half of 110063 can be outside the eighteen minutes
/// while the other half is inside. This table answers a different and
/// coarser question: "do you operate in my area at all", which is what a
/// customer types a pincode into a box to find out, and it gives that
/// area a name to show back to them.
model ServiceArea {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  city  String @default("New Delhi")
  state String @default("Delhi")

  /// Cleared to switch an area off without deleting its pincodes.
  isActive Boolean @default(true)

  pincodes        ServicePincode[]
  store           Store?
  consultRequests ConsultRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_areas")
}

/// One postal code, belonging to exactly one serviceable area.
///
/// `pincode` is unique: a code that mapped to two areas would make the
/// lookup ambiguous at the only moment it is used, and the customer would
/// get whichever row the database happened to return first.
model ServicePincode {
  id String @id @default(cuid())

  pincode String @unique

  areaId String
  area   ServiceArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([areaId])
  @@map("service_pincodes")
}

/// ---------------------------------------------------------------------
/// Consultations — the first slice of module 6.
///
/// A consultation is not a booking. Nothing here reserves a professional's
/// time, because there is no professional roster to reserve from yet: the
/// customer states a mode, a day and a half-day window they would prefer,
/// and Quoin calls back to confirm. The model is shaped around that
/// honesty — `preferredDate`/`preferredSlot` are a request, and `status`
/// only reaches `SCHEDULED` when a human has actually agreed a time.
///
/// When the roster lands, a `ConsultBooking` joins this table to a
/// professional and a real slot. This row stays what it is: the demand.
/// ---------------------------------------------------------------------

/// How the expert meets the customer.
enum ConsultMode {
  /// A scheduled video call. Costs Quoin nothing but the expert's time,
  /// so it is the free one, and it cannot measure anything.
  VIDEO
  /// An expert at the site. The only mode that can measure, survey and
  /// quote real work, and the only one that is chargeable.
  SITE_VISIT
}

/// The half-day window a customer asks for.
///
/// Deliberately coarse. An exact time would be a promise nothing in the
/// system can keep — there is no roster, no travel time and no capacity
/// model — and a slot picker that offers "11:30" implies all three.
enum ConsultSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum ConsultStatus {
  /// Submitted by the customer, nobody has called back yet.
  REQUESTED
  /// A time has been agreed with the customer by a human.
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ConsultRequest {
  id String @id @default(cuid())

  /// The code the customer is shown and reads out on the phone. Generated
  /// from an alphabet with no O/0 or I/1 for exactly that reason.
  reference String @unique

  mode   ConsultMode
  status ConsultStatus @default(REQUESTED)

  name String

  /// E.164, normalised by `normalizePhone` before it gets here — the same
  /// treatment auth gives it, so a customer who later signs in with the
  /// same number matches this row rather than sitting beside it.
  ///
  /// Unverified: no OTP is required to ask for a call back, because
  /// demanding one at the top of the funnel loses the customer at the only
  /// step that matters. Rate limiting on this column is what keeps that
  /// affordable — see the POST handler.
  phone String

  email String?

  /// Set when the request came from a signed-in session. Null is the
  /// ordinary case today; the storefront has no sign-in screen yet.
  ///
  /// SetNull rather than Cascade: a deleted account must not silently take
  /// an outstanding site visit off the operations list.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Where the work is. The area is the coarse locality Quoin operates in;
  /// the pincode is what the customer actually knows about their site, and
  /// is kept as text because a consultation may be asked for from outside
  /// the serviceable list — that is a lead, not an error.
  areaId  String?
  area    ServiceArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  pincode String?

  /// What the project is about, when it maps onto one catalogue category.
  /// SetNull rather than Restrict: `notes` carries the intent in the
  /// customer's own words, so losing the tidy label costs little, and a
  /// retired category must not block itself from being retired.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  notes String?

  /// The day asked for. `@db.Date` because this is a calendar day in the
  /// customer's head, not an instant — storing it as a timestamp would put
  /// a request for the 3rd on the 2nd for anyone reading it in UTC.
  preferredDate DateTime?    @db.Date
  preferredSlot ConsultSlot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Rate limiting reads by phone and recency; ops reads the queue by
  /// status and recency. Both are the hot paths, so both are indexed.
  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@map("consult_requests")
}
