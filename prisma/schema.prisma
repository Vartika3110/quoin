// Module 1 — identity, addresses and serviceability.
//
// Deliberately scoped: no catalogue, cart or order models yet. What is
// here is what every later module depends on — who the customer is, where
// they are, and whether Quoin can serve that location.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  STANDARD
  PRO
}

model User {
  id String @id @default(cuid())

  /// E.164, always normalised before it reaches the database (+919876543210).
  /// Storing raw user input here guarantees duplicate accounts.
  phone String  @unique
  name  String?
  email String? @unique

  /// Drives price resolution. A tier column rather than a boolean because
  /// trade/architect tiers are already implied by the storefront.
  tier UserTier @default(STANDARD)

  /// Paise, never rupees. Wallet is a running balance today; it becomes a
  /// derived sum over a ledger table when refunds and credits land.
  walletPaise Int @default(0)

  /// Access to the internal tools that change what the storefront sells.
  ///
  /// Deliberately not grantable through any route: it is set directly on
  /// the row, out of band, by someone with database access. An admin flag
  /// that some endpoint can flip is a privilege-escalation bug waiting
  /// for the endpoint that forgets to check who is asking.
  isStaff Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]

  @@map("users")
}

enum AddressLabel {
  HOME
  WORK
  /// A construction site — often has no formal address, hence `landmark`.
  SITE
  OTHER
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label    AddressLabel @default(HOME)
  line1    String
  line2    String?
  landmark String?
  city     String
  state    String
  pincode  String

  /// Serviceability is decided by coordinates, never by pincode. Pincodes
  /// straddle store radii and would make the 18-minute promise a lie.
  lat Float
  lng Float

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

/// A pending phone verification. Rows are kept after use rather than
/// deleted so that rate limiting can see recent history per phone.
model OtpChallenge {
  id    String @id @default(cuid())
  phone String

  /// HMAC of the code, never the code itself. A support engineer reading
  /// the table must not be able to log in as a customer.
  codeHash String

  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// A dark store. Serviceability and the delivery promise are computed
/// against these, so `instant` fulfilment is only ever offered where a
/// store can actually reach the customer.
model Store {
  id   String @id @default(cuid())
  code String @unique
  name String

  lat Float
  lng Float

  /// Straight-line kilometres. Road distance is what actually matters, so
  /// this is intentionally conservative until routing is wired in.
  serviceRadiusKm Float @default(6)

  /// The headline promise for in-stock items from this store.
  baseEtaMinutes Int @default(18)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stores")
}

/// ---------------------------------------------------------------------
/// Catalogue — module 2.
///
/// Ported from the Django `catalog` app, which has been removed. The
/// decisions carried over unchanged: money in integer paise, fulfilment
/// modelled per product rather than assumed, and imported provenance
/// quarantined behind `source*` fields that are reference data for
/// pricing and are never rendered to a customer.
/// ---------------------------------------------------------------------

/// How a listing reaches the customer. Drives cart splitting at checkout.
enum Fulfilment {
  /// In a dark store within a `Store` radius. The "18 minutes" promise.
  INSTANT
  /// Real stock, delivered on a chosen date — heavy or bulk goods.
  SCHEDULED
  /// No stock at all. Consumes a professional's time slot.
  BOOKABLE
  /// Cut or manufactured after the order is placed.
  MADE_TO_ORDER
}

/// How the price is expressed to the customer. Drives the add-to-cart UI.
enum PricingUnit {
  PER_PIECE
  PER_SQFT
  PER_RUNNING_FT
  PER_VISIT
  PER_BAG
  PER_LITRE
  PER_KG
}

/// Trust markers rendered as chips on product cards.
enum BadgeKind {
  EXPERTS_VERIFIED
  PREMIUM_QUALITY
  TOP_BRAND
  PREMIUM_FINISH
  BESTSELLER
}

model Brand {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Self-referential tree. Restrict rather than cascade: deleting a
  /// parent must never silently delete the products filed beneath it.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  /// Swatch keys composited into the storefront category tile. Real
  /// artwork replaces these; the column holds keys, not URLs, so the
  /// fallback renderer keeps working until photography exists.
  images String[] @default([])

  /// Manual sort order on the storefront; ties break by name.
  position Int     @default(0)
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id   String @id @default(cuid())
  sku  String @unique
  name String
  slug String @unique

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  description String @default("")

  fulfilment  Fulfilment  @default(SCHEDULED)
  pricingUnit PricingUnit @default(PER_PIECE)

  /// GST slab as a percentage: 0, 5, 12, 18 or 28. An integer rather than
  /// an enum because it is arithmetic on every invoice line, and an enum
  /// would only be unwrapped back to a number at each use.
  gstRatePct Int @default(18)

  badges BadgeKind[] @default([])

  /// Quoin's own image: a URL, empty until one exists. Takes precedence
  /// over everything else the storefront could draw.
  image String @default("")

  /// True when `image` came from an image model rather than a camera.
  ///
  /// Load-bearing, not bookkeeping: a generated picture of a real SKU has
  /// to be labelled as an illustration wherever it appears, or the
  /// storefront is telling a customer they will receive something nobody
  /// has photographed. The storefront reads this to render that label.
  imageIsGenerated Boolean @default(false)

  /// Meaningful only for `SCHEDULED` and `MADE_TO_ORDER`.
  leadTimeDays Int?

  isActive Boolean @default(true)

  variants ProductVariant[]

  /// ---- provenance: reference only, never customer-facing ------------
  /// Where an imported row came from and what the competitor charged.
  /// Never rendered, never treated as Quoin stock or imagery.
  sourceName         String?
  sourceUrl          String?
  sourceImageUrl     String?
  sourceAvailability String?
  sourcePricePaise   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([brandId])
  @@map("products")
}

/// A purchasable option. Every product has at least one. Products with
/// more than one display the cheapest as "₹X Onwards" rather than an
/// exact price — see `resolvePrice()` in src/lib/types/catalog.ts.
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label String @default("Standard")
  sku   String @unique

  /// List price before discount.
  mrpPaise   Int
  /// Sell price for a standard customer.
  pricePaise Int
  /// Quoin Pro trade rate. Null means Pro pays `pricePaise`.
  proPricePaise Int?

  /// Marble is not sold by the single sq.ft., nor cement by the bag.
  minQty  Int @default(1)
  stepQty Int @default(1)

  isDefault Boolean @default(true)
  isActive  Boolean @default(true)

  priceTiers PriceTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

/// Volume break. Contractors buy cement by the hundred bags.
model PriceTier {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  minQty Int
  /// Null means no upper bound.
  maxQty Int?

  pricePaise Int

  @@unique([variantId, minQty])
  @@index([variantId])
  @@map("price_tiers")
}

/// A named locality Quoin serves, with the pincodes that reach it.
///
/// Deliberately *not* the source of truth for the delivery promise —
/// `Store.serviceRadiusKm` still decides that, because a pincode straddles
/// store radii and half of 110063 can be outside the eighteen minutes
/// while the other half is inside. This table answers a different and
/// coarser question: "do you operate in my area at all", which is what a
/// customer types a pincode into a box to find out, and it gives that
/// area a name to show back to them.
model ServiceArea {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  city  String @default("New Delhi")
  state String @default("Delhi")

  /// Cleared to switch an area off without deleting its pincodes.
  isActive Boolean @default(true)

  pincodes ServicePincode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_areas")
}

/// One postal code, belonging to exactly one serviceable area.
///
/// `pincode` is unique: a code that mapped to two areas would make the
/// lookup ambiguous at the only moment it is used, and the customer would
/// get whichever row the database happened to return first.
model ServicePincode {
  id String @id @default(cuid())

  pincode String @unique

  areaId String
  area   ServiceArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([areaId])
  @@map("service_pincodes")
}
